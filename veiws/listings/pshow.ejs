<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>wanderLust</title>
    <link rel="stylesheet" href="/css/style.css"/>
    <link rel="stylesheet" href="/css/rating.css"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" 
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" 
    crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
<link href="https://api.mapbox.com/mapbox-gl-js/v3.9.4/mapbox-gl.css" rel="stylesheet">
<script src="https://api.mapbox.com/mapbox-gl-js/v3.9.4/mapbox-gl.js"></script>
</head>
<script>
    const maptoken="<%=process.env.MAP_TOKEN%>";
    const coordinates=<%-JSON.stringify(result.geometry.coordinates)%>;
</script>
<body>
    <%-include("../includes/navbar.ejs")%>
    <%-include("../includes/flash.ejs")%>
    <div class="row mt-3">
        <div class="head-show col-8 offset-2"><h1><%=result.title%></h1></div>
            <div class="card col-6 offset-2 show-card listing-card">
                <img src="<%=result.image.url%>" class="card-img-top show-img " alt="listing image">
                <div class="card-body">
                    <p class="card-text">Owned By :- <%=result.owner.username%></p><br>
                    
                    <p class="card-text"><%=result.description%></p>
                    <p class="card-text">&#8377;<%=result.price.toLocaleString('en-IN')%> </p>
                    <p class="card-text"><%=result.location%> </p>
                        <p class="card-text"><%=result.country%></p>
                </p>
                </div>
        </div>
        <%if(currUser &&  currUser._id.equals(result.owner._id)){%>
            <div class="btns">
                <form action="/listings/<%=result._id%>/edit"><button class=" btn btn-dark btn1">edit</button></form>
        <form action="/delete/<%=result._id%>?_method=delete" method="post">
            <button class=" btn btn-dark btn2">delete</button>
        </form>
            </div>
        <%}%>
</div>

    <%if(currUser){%>
        <hr>
    <div class="row mt-3 col-8 offset-2">
        <form action="/listings/<%=result._id%>/reviews" method="post" novalidate class="needs-validation">
            <div  class="mb-3 mt-3">
                <label for="rating" class="form-label">rating</label>
                <fieldset class="starability-slot">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                  </fieldset>
            </div>
            <div  class="mb-3 mt-3">
                <label for="comment" class="form-label">comment</label>
            <textarea name="review[comment]" id="comment" row="10" cols="30" class="form-control" required></textarea>
            <div class="invalid-feedback">comments must be non-empty</div>
            </div>
            <div  class="mb-3 mt-3">
                <button class="btn btn-outline-dark">submit</button>
            </div>
            
        </form>
    </div>
    <%}%>
    <hr>
    <div class="row mt-3 col-8 offset-2">
    <%for(ele of result.reviews){%>
    <div class="card col-5 ms-3 mb-3">
        <div class="card-body">
          <h5 class="card-title">@<%=ele.author.username%></h5>
          <p class="starability-result card-text" data-rating="<%=ele.rating%>"></p>
          <h6 class="card-subtitle mb-2 text-body-secondary"><%=ele.comment%></h6>
          <form method="post" action="/listings/<%=result._id%>/reviews/<%=ele._id%>?_method=delete" >
            <button>delete</button>
          </form>
        </div>
      </div>
    <%}%>
</div>
    <div class="row mt-3 col-8 offset-2">
        <h3>Where you’ll be</h3>
        <div id="map"></div>
    </div>
    <script src="/js/map.js"></script>
    <%-include("../includes/footer.ejs")%>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" 
integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" 
crossorigin="anonymous"></script>
<script src="/js/script.js"></script>
</body>
</html>